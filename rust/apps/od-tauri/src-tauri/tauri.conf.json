{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDesign",
  "version": "0.1.0",
  "identifier": "ai.open-design.desktop",
  "build": {
    "frontendDist": "../web-placeholder",
    "beforeDevCommand": "npm run build:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["od"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
